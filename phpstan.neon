includes:
    - phpstan-baseline.neon

parameters:
    # Анализируем под МИНИМАЛЬНУЮ поддерживаемую версию: на машине разработчика
    # стоит 8.5, и синтаксис новее 8.2 проходит локально, а сборка падает
    # разбором файла. Так и случилось с типизированными константами (8.3+).
    phpVersion: 80200

    ignoreErrors:
        # These fire inside the AddsBlockContent/AddsInlineContent traits;
        # PHPStan attributes trait findings to whichever using class it
        # analysed first, so a path-pinned baseline entry flaps between
        # runs. Ignored path-independently instead.
        -
            message: '#^Instanceof between Dskripchenko\\PhpDocx\\Element\\BlockElement and Dskripchenko\\PhpDocx\\Element\\BlockElement will always evaluate to true\.$#'
            identifier: instanceof.alwaysTrue
            reportUnmatched: false
        -
            message: '#^Instanceof between Dskripchenko\\PhpDocx\\Element\\InlineElement and Dskripchenko\\PhpDocx\\Element\\InlineElement will always evaluate to true\.$#'
            identifier: instanceof.alwaysTrue
            reportUnmatched: false
    level: 8
    paths:
        - src
    excludePaths: []
