{
    "name": "dskripchenko/php-docx",
    "description": "Minimal HTML → DOCX (OOXML) converter without legacy dependencies. Focused on print-form use case: tables, paragraphs, images, headers/footers.",
    "type": "library",
    "license": "MIT",
    "keywords": ["docx", "ooxml", "word", "html-to-docx", "print"],
    "authors": [
        {
            "name": "Denis Skripchenko",
            "email": "denskrp90@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-dom": "*",
        "ext-mbstring": "*",
        "ext-zip": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Dskripchenko\\PhpDocx\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dskripchenko\\PhpDocx\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
